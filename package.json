{
  "name": "tcgplayer-cart-optimizer",
  "version": "0.1.0",
  "description": "Optimize a TCGplayer cart for total price including per-seller shipping thresholds.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
